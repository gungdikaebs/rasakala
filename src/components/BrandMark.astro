---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---

<span class="inline-flex items-center gap-2.5 font-display text-[1.7rem] leading-none tracking-[-.02em]" aria-label="Rasakala">
	<svg class="h-8 w-8 fill-none stroke-current stroke-[1.15]" viewBox="0 0 38 38" aria-hidden="true">
		<circle cx="19" cy="19" r="15.5"></circle>
		<path d="M19 8.5v21M8.5 19h21M11.6 11.6l14.8 14.8M26.4 11.6 11.6 26.4"></path>
		<circle cx="19" cy="19" r="3.4"></circle>
	</svg>
	{!compact && <span>Rasakala</span>}
</span>
