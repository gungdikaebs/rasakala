---
const drinks = [
	{ name: 'Kopi Kala', note: 'Espresso · susu · gula aren', price: '32' },
	{ name: 'Senja Latte', note: 'Espresso · susu · karamel halus', price: '34' },
	{ name: 'Kintamani Filter', note: 'Single origin Bali · seasonal', price: '38' },
	{ name: 'Cocoa Bali', note: 'Dark chocolate · susu', price: '32' },
];
---

<section class="bg-espresso px-4 py-24 text-paper min-[801px]:px-(--page-gutter) min-[801px]:py-[clamp(6rem,11vw,10rem)]" id="menu" aria-labelledby="menu-heading">
	<header class="mb-12 grid grid-cols-1 items-start gap-6 min-[801px]:mb-20 min-[801px]:grid-cols-[1fr_2fr]" data-reveal>
		<p class="mt-3 text-[.68rem] font-semibold uppercase tracking-[.13em]">02 — From the bar</p>
		<h2 class="font-display text-[clamp(4rem,8vw,8rem)] font-normal leading-[.83] tracking-[-.04em]" id="menu-heading">Dibuat baik.<br /><em class="font-normal text-[#c6b998]">Dinikmati pelan.</em></h2>
	</header>
	<div class="grid grid-cols-1 items-center gap-16 min-[801px]:grid-cols-[minmax(18rem,.75fr)_1.3fr] min-[801px]:gap-[clamp(3rem,8vw,9rem)]">
		<figure class="mx-auto w-[88%] -rotate-2 bg-paper p-3 pb-[4.5rem] text-espresso min-[801px]:mx-0 min-[801px]:w-auto" data-reveal>
			<img class="aspect-[4/4.6] w-full object-cover" src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/kopi-kala.webp`} alt="Kopi Kala, es kopi susu gula aren khas Rasakala" loading="lazy" width="900" height="1125" />
			<figcaption class="flex items-end justify-between px-1.5 pt-4"><span class="text-[.62rem] uppercase tracking-[.12em]">Signature 01</span><strong class="font-display text-3xl font-normal italic">Kopi Kala</strong></figcaption>
		</figure>
		<div data-reveal>
			<p class="mb-4 flex justify-between border-b border-paper/30 pb-4 text-[.68rem] font-semibold uppercase tracking-[.13em]">House favourites <span class="hidden opacity-50 min-[801px]:inline">Harga dalam ribuan</span></p>
			{drinks.map((drink, index) => (
				<article class="grid grid-cols-[2rem_1fr_auto] items-center gap-4 border-b border-paper/20 py-5"><span class="text-[.6rem] opacity-50">0{index + 1}</span><div><h3 class="font-display text-[clamp(1.8rem,3vw,3rem)] font-normal">{drink.name}</h3><p class="mt-1 text-xs opacity-55">{drink.note}</p></div><strong class="font-display text-xl font-normal">{drink.price}</strong></article>
			))}
			<div class="mt-8 flex flex-wrap gap-2.5 text-[.68rem] font-semibold uppercase tracking-[.13em]">{['Espresso','Milk Coffee','Manual Brew','Non Coffee','Pastry'].map(category => <span class="border border-paper/30 px-3 py-2.5">{category}</span>)}</div>
		</div>
	</div>
</section>
